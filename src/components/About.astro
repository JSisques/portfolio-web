---
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="about" class="section">
  <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
    <div>
      <p class="eyebrow mb-6">{t('about.eyebrow')}</p>
      <h2 class="heading-md">{t('about.title')}</h2>
    </div>
    <div class="space-y-5 text-base leading-relaxed text-text-muted sm:text-lg">
      <p>{t('about.body1')}</p>
      <p>{t('about.body2')}</p>
    </div>
  </div>
</section>
