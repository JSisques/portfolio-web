---
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="about" class="section">
  <div class="section-head">
    <span class="section-head__label">01 — {t('about.eyebrow')}</span>
    <h2>{t('about.title')}</h2>
  </div>
  <div class="indent about-copy max-w-[68ch] space-y-5" data-reveal>
    <p class="text-[1.05rem] leading-[1.75] text-ink-muted" set:html={t('about.body1')} />
    <p class="text-[1.05rem] leading-[1.75] text-ink-muted" set:html={t('about.body2')} />
  </div>
</section>
