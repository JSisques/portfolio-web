---
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { social } from '../data/social';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="contact" class="section">
  <div class="max-w-xl" data-reveal>
    <h2 class="text-balance font-display text-3xl leading-tight sm:text-4xl" set:html={t('contact.title')} />
    <p class="mt-6 max-w-md text-[1.05rem] leading-relaxed text-ink-muted">{t('contact.body')}</p>

    <a
      href={`mailto:${social.email}`}
      class="mt-9 inline-block border-b border-line font-display text-xl italic text-ink transition-colors duration-300 hover:border-accent hover:text-accent sm:text-2xl"
    >
      {social.email}
    </a>

    <div class="mt-8 flex items-center gap-6 font-mono text-sm">
      <a href={social.github} target="_blank" rel="noopener noreferrer" class="text-ink-muted transition-colors hover:text-ink">GitHub ↗</a>
      {social.linkedin && (
        <a href={social.linkedin} target="_blank" rel="noopener noreferrer" class="text-ink-muted transition-colors hover:text-ink">LinkedIn ↗</a>
      )}
    </div>
  </div>
</section>
