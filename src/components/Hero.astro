---
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="hero" class="wrap py-20 sm:py-28 lg:py-36">
  <p class="mb-7 flex items-center gap-2.5 font-mono text-xs uppercase tracking-wider text-ink-faint" data-reveal>
    <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
    {t('hero.status')}
  </p>

  <h1 class="max-w-[16ch] text-balance font-display text-4xl leading-[1.12] tracking-tight sm:text-5xl lg:text-6xl" data-reveal data-reveal-delay="80">
    {t('hero.title.line1')} <em class="text-accent">{t('hero.title.line2')}</em>
  </h1>

  <p class="mt-8 max-w-2xl text-[1.05rem] leading-relaxed text-ink-muted" data-reveal data-reveal-delay="160">
    {t('hero.subtitle')}
  </p>

  <div class="mt-11 flex flex-wrap items-center gap-5" data-reveal data-reveal-delay="240">
    <a href="#projects" class="btn-solid">{t('hero.cta.projects')}</a>
    <a href="#contact" class="btn-text">{t('hero.cta.contact')} →</a>
  </div>
</section>
