---
import type { Locale } from '../i18n/ui';
import { useTranslations, otherLocale, localizedPath } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const other = otherLocale(lang);

const links: { href: string; label: string }[] = [
  { href: '#about', label: t('nav.about') },
  { href: '#stack', label: t('nav.stack') },
  { href: '#projects', label: t('nav.projects') },
  { href: '#timeline', label: t('nav.timeline') },
];
---

<header
  data-nav
  class="sticky top-0 z-50 border-b border-line-soft bg-ground/90 backdrop-blur-md transition-colors duration-300"
>
  <div class="wrap flex items-center justify-between py-5">
    <a href={localizedPath(lang, '/')} class="font-display text-lg italic text-ink">Javier Sisques</a>

    <nav class="hidden items-center gap-8 font-body text-sm md:flex">
      {links.map((link) => (
        <a href={link.href} data-nav-link class="nav-link">
          {link.label}
        </a>
      ))}
    </nav>

    <a
      href={localizedPath(other, '/')}
      class="rounded-[3px] border border-line px-2.5 py-1.5 font-mono text-xs text-ink-muted transition-colors hover:border-ink-faint hover:text-ink"
      aria-label="Switch language"
    >
      {t('lang.switch')}
    </a>
  </div>
</header>
