---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: Locale;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);
const { data } = project;

const statusLabel = {
  live: t('projects.status.live'),
  wip: t('projects.status.wip'),
  archived: t('projects.status.archived'),
}[data.status];
---

<article class="project-card flex h-full flex-col p-8 transition-colors duration-300 hover:bg-surface sm:p-9">
  <div class="mb-5 flex items-center justify-between font-mono text-[0.68rem] uppercase tracking-wide text-ink-faint">
    <span class="flex items-center gap-1.5">
      <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
      {statusLabel}
    </span>
    <span>{data.year}</span>
  </div>

  <h3 class="font-display text-2xl font-medium text-ink">{data.title}</h3>
  <p class="mt-2 font-display text-[0.98rem] italic text-ink-muted">{data.tagline}</p>

  <p class="mt-5 flex-grow text-sm leading-relaxed text-ink-muted">{data.description}</p>

  <p class="mt-6 font-mono text-xs leading-loose text-ink-faint">
    {data.stack.join(' · ')}
  </p>

  <div class="mt-6 flex items-center gap-6 border-t border-line-soft pt-5">
    {data.links.github && (
      <a href={data.links.github} target="_blank" rel="noopener noreferrer" class="text-sm text-ink-muted transition-colors hover:text-accent">
        {t('projects.link.github')} ↗
      </a>
    )}
    {data.links.live && (
      <a href={data.links.live} target="_blank" rel="noopener noreferrer" class="text-sm text-ink-muted transition-colors hover:text-accent">
        {t('projects.link.live')} ↗
      </a>
    )}
  </div>
</article>
