---
import { getCollection } from 'astro:content';
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import ProjectCard from './ProjectCard.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = (await getCollection('projects', ({ data }) => data.lang === lang)).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order,
);
---

<section id="projects" class="section">
  <p class="eyebrow mb-6" data-reveal>{t('projects.eyebrow')}</p>
  <div class="mb-14 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between" data-reveal>
    <h2 class="heading-md max-w-xl">{t('projects.title')}</h2>
    <p class="max-w-sm text-sm leading-relaxed text-text-muted">{t('projects.subtitle')}</p>
  </div>

  {
    projects.length === 0 ? (
      <p class="font-mono text-sm text-text-dim">{t('projects.empty')}</p>
    ) : (
      <div class="grid items-stretch gap-6 sm:grid-cols-2 xl:grid-cols-3">
        {projects.map((project, i) => (
          <ProjectCard project={project} lang={lang} index={i} />
        ))}
      </div>
    )
  }
</section>
