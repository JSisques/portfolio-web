---
import { getCollection } from 'astro:content';
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import ProjectCard from './ProjectCard.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = (await getCollection('projects', ({ data }) => data.lang === lang)).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order,
);
---

<section id="projects" class="section">
  <div class="section-head">
    <span class="section-head__label">03 — {t('projects.eyebrow')}</span>
    <h2>{t('projects.title')}</h2>
  </div>

  {
    projects.length === 0 ? (
      <p class="indent font-mono text-sm text-ink-faint">{t('projects.empty')}</p>
    ) : (
      <div class="indent grid items-stretch border border-line-soft sm:grid-cols-2" data-reveal>
        {projects.map((project, i) => (
          <div class:list={['flex', i > 0 && 'border-t border-line-soft sm:border-t-0 sm:border-l']}>
            <ProjectCard project={project} lang={lang} />
          </div>
        ))}
      </div>
    )
  }
</section>
