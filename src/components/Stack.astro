---
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const groups: { label: string; items: string[] }[] = [
  { label: t('stack.cat.languages'), items: ['TypeScript', 'JavaScript', 'Python', 'Bash'] },
  {
    label: t('stack.cat.backend'),
    items: ['Node.js', 'NestJS', 'GraphQL', 'PostgreSQL', 'Prisma', 'Redis', 'Kafka'],
  },
  { label: t('stack.cat.frontend'), items: ['React', 'Next.js', 'Astro', 'Tailwind CSS'] },
  {
    label: t('stack.cat.infra'),
    items: ['Docker', 'Kubernetes', 'Terraform', 'Ansible', 'Jenkins', 'Argo CD', 'Prometheus'],
  },
];
---

<section id="stack" class="section">
  <div class="section-head">
    <span class="section-head__label">02 — {t('stack.eyebrow')}</span>
    <h2>{t('stack.title')}</h2>
  </div>

  <div class="indent grid grid-cols-1 border-t border-l border-line-soft sm:grid-cols-2 lg:grid-cols-4" data-reveal>
    {groups.map((group) => (
      <div class="border-r border-b border-line-soft px-6 py-6">
        <h3 class="mb-4 font-mono text-[0.7rem] uppercase tracking-wide text-ink-faint">{group.label}</h3>
        <ul class="space-y-2.5">
          {group.items.map((item) => (
            <li class="text-[0.92rem] text-ink-muted">{item}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
