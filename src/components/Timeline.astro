---
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { timeline } from '../data/timeline';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const entries = timeline[lang];
---

<section id="timeline" class="section">
  <p class="eyebrow mb-6">{t('timeline.eyebrow')}</p>
  <h2 class="heading-md mb-14 max-w-xl">{t('timeline.title')}</h2>

  <ol class="relative space-y-10 border-l border-line pl-8">
    {entries.map((entry) => (
      <li class="relative">
        <span class="absolute -left-[calc(2rem+5px)] top-1.5 h-2.5 w-2.5 rounded-full bg-primary-soft shadow-[0_0_0_4px_var(--color-bg-panel)]"></span>
        <p class="font-mono text-xs uppercase tracking-widest text-text-dim">{entry.period}</p>
        <h3 class="mt-2 font-display text-xl font-semibold text-text">
          {entry.role} <span class="text-text-dim">/</span> <span class="text-primary-soft">{entry.place}</span>
        </h3>
        <p class="mt-2 max-w-2xl text-sm leading-relaxed text-text-muted">{entry.description}</p>
      </li>
    ))}
  </ol>
</section>
