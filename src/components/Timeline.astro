---
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { timeline } from '../data/timeline';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const entries = timeline[lang];
---

<section id="timeline" class="section">
  <div class="section-head">
    <span class="section-head__label">04 — {t('timeline.eyebrow')}</span>
    <h2>{t('timeline.title')}</h2>
  </div>

  <div class="indent" data-reveal>
    {entries.map((entry, i) => (
      <div class:list={['grid grid-cols-1 gap-2 py-6 sm:grid-cols-[140px_1fr] sm:gap-8 sm:py-7', i > 0 && 'border-t border-line-soft']}>
        <p class="pt-1 font-mono text-[0.76rem] text-ink-faint">{entry.period}</p>
        <div>
          <h3 class="font-body text-base font-semibold text-ink">
            {entry.role} <span class="font-normal text-ink-muted">· {entry.place}</span>
          </h3>
          <p class="mt-2 max-w-2xl text-sm leading-relaxed text-ink-muted">{entry.description}</p>
        </div>
      </div>
    ))}
  </div>
</section>
